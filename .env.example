# Generate unique values with a password manager. Never commit real values.
SESSION_HMAC_SECRET=replace-with-64-plus-random-characters
LICENSE_PEPPER=replace-with-64-plus-random-characters
ADMIN_PASSWORD_HASH=scrypt$replace_with_scrypt_hash
ADMIN_2FA_PIN_HASH=scrypt$replace_with_scrypt_hash_of_010511
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
APP_ORIGIN=https://admin.example.com
# Injected by the Supabase integration or copied from Supabase Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
